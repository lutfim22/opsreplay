# Copy to .env.local for local development. Never commit real values.

# Required for "Investigate with AI". Server-only; never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# Optional. Upstream timeout in ms (default 25000, max 55000).
# GEMINI_TIMEOUT_MS=25000

# Optional. Requests per minute per client IP for /api/investigate (default 10).
# INVESTIGATE_RATE_LIMIT_PER_MINUTE=10

# Optional. Raises the GitHub API rate limit for /api/github/events.
# GITHUB_TOKEN=
