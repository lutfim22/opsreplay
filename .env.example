# Copy to .env.local for local development. Never commit real values.

# Disabled by default. Set exactly 1 only after approving AI access and cost exposure.
# Server-only; never prefix with NEXT_PUBLIC_. Credentials alone do not enable AI.
INVESTIGATE_ENABLED=0

# Required when "Investigate with AI" is explicitly enabled. Server-only.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# Optional. Upstream timeout in ms (default 25000, max 55000).
# GEMINI_TIMEOUT_MS=25000

# Required for enabled Vercel Preview/Production investigation. Use separate Redis databases.
# Keep both values server-only; use the REST endpoint and REST token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local development only: explicitly bypass Redis with a per-process demo limiter.
# Never set this for production; production ignores it.
# INVESTIGATE_LOCAL_DEV_BYPASS=1
# INVESTIGATE_RATE_LIMIT_PER_MINUTE=10

# Optional. Raises the GitHub API rate limit for /api/github/events.
# GITHUB_TOKEN=
